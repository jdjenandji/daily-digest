{
  "location": {
    "label": "Berlin",
    "latitude": 52.52,
    "longitude": 13.405,
    "timezone": "Europe/Berlin"
  },
  "calendar": {
    "include": null,
    "exclude": [
      "Birthdays",
      "Siri Suggestions"
    ],
    "includeAllDay": true
  },
  "output": {
    "dir": "./out",
    "filename": "daily-digest-{date}.pdf",
    "writeLatest": true,
    "openAfterGenerate": false
  },
  "headlinesPerSource": 4,
  "news": [
    {
      "id": "wsj",
      "name": "The Wall Street Journal",
      "adapter": "rss",
      "url": "https://feeds.content.dowjones.io/public/rss/RSSWorldNews"
    },
    {
      "id": "ft",
      "name": "Financial Times",
      "adapter": "rss",
      "url": "https://www.ft.com/rss/home"
    },
    {
      "id": "nyt",
      "name": "The New York Times",
      "adapter": "rss",
      "url": "https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml"
    },
    {
      "id": "reuters",
      "name": "Reuters",
      "adapter": "sitemap",
      "url": "https://www.reuters.com/arc/outboundfeeds/news-sitemap/?outputType=xml",
      "excludeLocales": [
        "de",
        "fr",
        "jp",
        "br",
        "cn",
        "es",
        "it",
        "ar",
        "kr",
        "ru",
        "in"
      ]
    },
    {
      "id": "bild",
      "name": "Bild",
      "adapter": "rss",
      "url": "https://www.bild.de/feed/news.xml",
      "kicker": true,
      "enabled": false
    },
    {
      "id": "lemonde",
      "name": "Le Monde",
      "adapter": "rss",
      "url": "https://www.lemonde.fr/rss/une.xml",
      "headlineLines": 3,
      "headlineMaxChars": 150
    },
    {
      "id": "artnet",
      "name": "Artnet News",
      "adapter": "rss",
      "url": "https://news.artnet.com/feed",
      "page": "art",
      "limit": 8
    }
  ],
  "markets": {
    "provider": "cnbc",
    "groups": [
      {
        "label": "Americas",
        "symbols": [
          "spx",
          "dji",
          "ixic"
        ]
      },
      {
        "label": "Europe",
        "symbols": [
          "dax",
          "ftse",
          "cac"
        ]
      },
      {
        "label": "Asia",
        "symbols": [
          "n225",
          "hsi"
        ]
      },
      {
        "label": "Commodities",
        "symbols": [
          "gold",
          "wti"
        ]
      },
      {
        "label": "Crypto",
        "symbols": [
          "btc"
        ]
      },
      {
        "label": "Stocks",
        "columns": 2,
        "symbols": [
          "sp500acc",
          "ftseallworld",
          "physicalgold",
          "alphabet",
          "mscieuhighdiv",
          "bloom",
          "creditagricole",
          "airbus",
          "robinhood",
          "goldmansachs"
        ]
      }
    ],
    "instruments": {
      "spx": {
        "name": "S&P 500",
        "cnbc": ".SPX",
        "yahoo": "^GSPC"
      },
      "dji": {
        "name": "Dow Jones",
        "cnbc": ".DJI",
        "yahoo": "^DJI"
      },
      "ixic": {
        "name": "Nasdaq Composite",
        "cnbc": ".IXIC",
        "yahoo": "^IXIC"
      },
      "dax": {
        "name": "DAX",
        "cnbc": ".GDAXI",
        "yahoo": "^GDAXI"
      },
      "ftse": {
        "name": "FTSE 100",
        "cnbc": ".FTSE",
        "yahoo": "^FTSE"
      },
      "cac": {
        "name": "CAC 40",
        "cnbc": ".FCHI",
        "yahoo": "^FCHI"
      },
      "n225": {
        "name": "Nikkei 225",
        "cnbc": ".N225",
        "yahoo": "^N225"
      },
      "hsi": {
        "name": "Hang Seng",
        "cnbc": ".HSI",
        "yahoo": "^HSI"
      },
      "gold": {
        "name": "Gold",
        "cnbc": "@GC.1",
        "yahoo": "GC=F",
        "digits": 2
      },
      "wti": {
        "name": "Oil (WTI)",
        "cnbc": "@CL.1",
        "yahoo": "CL=F",
        "digits": 2
      },
      "btc": {
        "name": "Bitcoin",
