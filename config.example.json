        "cnbc": "PPFB-DE",
        "yahoo": "PPFB.DE",
        "digits": 2
      },
      "alphabet": {
        "name": "Alphabet A",
        "cnbc": "GOOGL",
        "yahoo": "GOOGL",
        "digits": 2
      },
      "mscieuhighdiv": {
        "name": "MSCI Europe Div",
        "yahoo": "EHF1.DE",
        "digits": 2
      },
      "bloom": {
        "name": "Bloom Energy",
        "cnbc": "BE",
        "yahoo": "BE",
        "digits": 2
      },
      "creditagricole": {
        "name": "Crédit Agricole",
        "cnbc": "ACA-FR",
        "yahoo": "ACA.PA",
        "digits": 2
      },
      "airbus": {
        "name": "Airbus",
        "cnbc": "AIR-FR",
        "yahoo": "AIR.PA",
        "digits": 2
      },
      "robinhood": {
        "name": "Robinhood A",
        "cnbc": "HOOD",
        "yahoo": "HOOD",
        "digits": 2
      },
      "goldmansachs": {
        "name": "Goldman Sachs",
        "cnbc": "GS",
        "yahoo": "GS",
        "digits": 2
      }
    }
  },
  "predictions": {
    "enabled": true,
    "endpoint": "https://gamma-api.polymarket.com/markets",
    "limit": 3,
    "freshMinutes": 15,
    "timeoutMs": 8000,
    "maxStaleHours": 24
  },
  "timeouts": {
    "weatherMs": 5000,
    "newsMs": 8000,
    "quoteMs": 5000,
    "calendarMs": 8000,
    "totalMs": 30000
  },
  "cache": {
    "freshMinutes": 15,
    "weatherMaxStaleHours": 6,
    "marketsMaxStaleHours": 18,
    "newsMaxStaleHours": 24
  },
  "server": {
    "host": "127.0.0.1",
    "port": 4174
  },
  "chrome": {
    "executablePath": null
  },
  "schedule": {
    "hour": 6,
    "minute": 30
  },
  "print": {
    "enabled": false,
    "printer": null,
    "media": "A4",
    "sides": "two-sided-long-edge",
    "colorMode": "monochrome",
    "cancelPreviousJobs": true,
    "extraOptions": []
  },
  "poem": {
    "enabled": true,
    "endpoint": "https://api.parse.bot/scraper/18773879-45ca-4c85-a458-3e9c4a4d59ca/get_poem_of_the_day",
    "apiKey": null,
    "timeoutMs": 8000,
    "maxStaleDays": 7
  },
  "meme": {
    "label": "Meme of the day",
    "enabled": true,
    "channel": "sacred-memes",
    "variant": "display",
    "maxKb": 400,
    "maxHeightMm": 50,
    "timeoutMs": 8000,
    "downloadTimeoutMs": 15000,
    "maxStaleDays": 7
  },
  "announcements": {
    "enabled": true,
    "label": "Announcements",
    "url": "https://www.e-flux.com/announcements/",
    "source": "e-flux",
    "limit": 14,
    "timeoutMs": 12000,
    "maxStaleHours": 48
  }
}
